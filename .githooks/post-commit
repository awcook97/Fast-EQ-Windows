#!/usr/bin/env bash
# Auto-sync plugins after a commit.
# Enabled by `git config core.hooksPath .githooks` (setup.sh does this).
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if command -v uv >/dev/null 2>&1; then
    uv run python scripts/sync_plugins.py
else
    python3 scripts/sync_plugins.py
fi
